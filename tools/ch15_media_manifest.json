      "scene": "1:after",
      "line": 4,
      "speaker": "윤진아",
      "text": "저기요! 고맙습니다! 진짜 진짜 고마워요!",
      "path": "img/story/ch15-03.webp",
      "bytes": 70360,
      "sha256": "1e922f720e37bfccac166ac72c95e1a12feca0bde696958fd1b437ac6292e9a6"
